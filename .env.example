# --- Veritabanı -------------------------------------------------------------
# Uygulamanın kullandığı adres.
#   Neon     : verdiği tek adres (pooled endpoint tercih edilir)
#   Supabase : POOLER adresi, port 6543 (transaction mode)
#   Yerel    : postgresql://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL="postgresql://user:pass@host:5432/rakip_reklam?sslmode=require"

# Yalnızca göçler için doğrudan bağlantı. Supabase'te port 5432'li adres.
# Neon ve yerel kurulumda BOŞ BIRAKIN — DATABASE_URL kullanılır.
DIRECT_DATABASE_URL=""

# Yerel PGlite sunucusu tek bağlantı kabul eder; üretimde bu satırı silin.
DB_POOL_MAX=""

# --- Kimlik doğrulama -------------------------------------------------------
# Oturum çerezini imzalamak için rastgele sır: openssl rand -base64 32
AUTH_SECRET="degistir-bunu-en-az-32-karakter-olmali!!"
# Girişe izinli e-posta adresleri (virgülle ayrılır, büyük/küçük harf duyarsız)
ALLOWED_EMAILS="omer.uruc@branchsight.com"
# Tüm ekip için tek ortak giriş şifresi
AUTH_PASSWORD="pilot-donemi-sifresi"

# --- Slack ------------------------------------------------------------------
# Bildirimlerin gideceği TEK kanalın Incoming Webhook adresi.
# AC-11: bu değer asla veritabanına yazılmaz, arayüzde gösterilmez.
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/xxx/yyy/zzz"
# Teknik alarmlar (sıfır sonuç, scraper arızası) için ayrı webhook.
# Boş bırakılırsa alarmlar da ana kanala düşer.
SLACK_ALERT_WEBHOOK_URL=""

# --- Apify ------------------------------------------------------------------
APIFY_TOKEN="apify_api_xxx"
# Aktif actor. Actor bozulursa yalnızca bu değer değiştirilir, kod değişmez.
APIFY_ACTOR_ID="curious_coder/facebook-ads-library-scraper"
# Actor'ün beklediği girdi şeması: "urls" | "startUrls" | "pageIds"
# scripts/verify-actor.ts ile hangisinin çalıştığını tespit edin.
APIFY_INPUT_MODE="urls"
# RAKİP BAŞINA azami reklam sayısı (actor girdisinde limitPerSource).
# Toplam sınır değildir — toplam sınır kullanılırsa sıraya sonradan giren
# rakiplerin reklamları hiç gelmez ve yanlışlıkla "durmuş" sayılırlar.
# Maliyet reklam başına ücretlendiği için bu değer yalnızca üst tavandır.
APIFY_LIMIT_PER_SOURCE="100"
# Apify çalıştırmasının azami süresi (saniye)
APIFY_TIMEOUT_SECS="900"

# --- Inngest ----------------------------------------------------------------
# Yerel geliştirmede boş bırakılabilir (inngest dev server kullanılır)
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Eşleştirme ekranındaki aday sayfaları getiren actor (opsiyonel).
# Tanımlı değilse Page ID elle girilir — eşleştirme yine insan onaylıdır.
APIFY_PAGE_SEARCH_ACTOR_ID=""

# --- Uygulama ---------------------------------------------------------------
# Slack mesajlarındaki "Panelde Gör" bağlantısının kökü
APP_URL="http://localhost:3000"
# Tek taramada bundan fazla yeni reklam bulunursa tek tek mesaj yerine
# tek bir toplu mesaj atılır (ilk tarama kanalı boğmasın).
NOTIFY_BURST_LIMIT="25"
